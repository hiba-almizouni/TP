@model Appreciation

@{
    ViewData["Title"] = "Modifier une Appréciation";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header">
                <i class="bi bi-pencil-square me-2"></i>Modifier l'Appréciation de : <strong>@Model.NomPers</strong>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="NomPers" class="form-label fw-semibold"></label>
                        <input asp-for="NomPers" class="form-control" />
                        <span asp-validation-for="NomPers" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="HotelId" class="form-label fw-semibold">Hôtel</label>
                        <select asp-for="HotelId" asp-items="ViewBag.HotelId" class="form-select"></select>
                        <span asp-validation-for="HotelId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Commentaire" class="form-label fw-semibold"></label>
                        <textarea asp-for="Commentaire" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Commentaire" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Note" class="form-label fw-semibold">Note (1 à 10)</label>
                        <input asp-for="Note" class="form-control" type="number" min="1" max="10" />
                        <span asp-validation-for="Note" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-save me-1"></i>Enregistrer les modifications
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Retour à la liste
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
