@model Hotel

@{
    ViewData["Title"] = "Créer un Hôtel";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header">
                <i class="bi bi-plus-circle me-2"></i>Créer un nouvel Hôtel
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Nom" class="form-label fw-semibold"></label>
                        <input asp-for="Nom" class="form-control" placeholder="Ex: Hôtel El Mouradi" />
                        <span asp-validation-for="Nom" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Etoiles" class="form-label fw-semibold">Nombre d'Étoiles (1 à 5)</label>
                        <input asp-for="Etoiles" class="form-control" type="number" min="1" max="5" />
                        <span asp-validation-for="Etoiles" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Ville" class="form-label fw-semibold"></label>
                        <input asp-for="Ville" class="form-control" placeholder="Ex: Tunis" />
                        <span asp-validation-for="Ville" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="SiteWeb" class="form-label fw-semibold"></label>
                        <input asp-for="SiteWeb" class="form-control" placeholder="https://www.monhotel.com" />
                        <span asp-validation-for="SiteWeb" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Tel" class="form-label fw-semibold"></label>
                        <input asp-for="Tel" class="form-control" placeholder="+216 XX XXX XXX" />
                        <span asp-validation-for="Tel" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Pays" class="form-label fw-semibold"></label>
                        <input asp-for="Pays" class="form-control" placeholder="Tunisie" />
                        <span asp-validation-for="Pays" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-circle me-1"></i>Enregistrer
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Annuler
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
