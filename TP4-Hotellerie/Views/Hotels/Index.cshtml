@model IEnumerable<Hotel>

@{
    ViewData["Title"] = "Liste des Hôtels";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-building me-2 text-primary"></i>Liste des Hôtels</h2>
    <div>
        <a asp-action="Create" class="btn btn-success me-2">
            <i class="bi bi-plus-circle me-1"></i>Créer un Hôtel
        </a>
        <a asp-controller="Appreciations" asp-action="Index" class="btn btn-outline-primary">
            <i class="bi bi-star me-1"></i>Voir les Appréciations
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>Aucun hôtel enregistré. Commencez par en créer un !
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead>
                    <tr>
                        <th><i class="bi bi-card-text me-1"></i>Nom</th>
                        <th><i class="bi bi-star-fill me-1"></i>Étoiles</th>
                        <th><i class="bi bi-geo-alt me-1"></i>Ville</th>
                        <th><i class="bi bi-globe me-1"></i>Site Web</th>
                        <th><i class="bi bi-telephone me-1"></i>Téléphone</th>
                        <th><i class="bi bi-flag me-1"></i>Pays</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var hotel in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@hotel.Nom</td>
                            <td>
                                @for (int i = 0; i < hotel.Etoiles; i++)
                                {
                                    <i class="bi bi-star-fill star-gold"></i>
                                }
                                @for (int i = hotel.Etoiles; i < 5; i++)
                                {
                                    <i class="bi bi-star text-secondary"></i>
                                }
                            </td>
                            <td>@hotel.Ville</td>
                            <td>
                                <a href="@hotel.SiteWeb" target="_blank" class="text-decoration-none">
                                    <i class="bi bi-box-arrow-up-right me-1"></i>@hotel.SiteWeb
                                </a>
                            </td>
                            <td>@(hotel.Tel ?? "-")</td>
                            <td>@(hotel.Pays ?? "Tunisie")</td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@hotel.Id"
                                   class="btn btn-sm btn-info btn-action text-white" title="Détails">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@hotel.Id"
                                   class="btn btn-sm btn-warning btn-action" title="Modifier">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@hotel.Id"
                                   class="btn btn-sm btn-danger btn-action" title="Supprimer">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <p class="text-muted mt-2"><small>Total : @Model.Count() hôtel(s) enregistré(s)</small></p>
}
