<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hotellerie App</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        body { background-color: #f8f9fa; }
        .navbar-brand { font-weight: 700; font-size: 1.4rem; }
        .star-gold { color: #ffc107; }
        footer { background-color: #343a40; color: #adb5bd; padding: 1rem 0; margin-top: 3rem; }
        .table thead th { background-color: #0d6efd; color: white; }
        .card-header { background-color: #0d6efd; color: white; font-weight: 600; }
        .btn-action { margin: 0 2px; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
        <div class="container">
            <a class="navbar-brand" asp-controller="Hotels" asp-action="Index">
                <i class="bi bi-building me-2"></i>Hotellerie App
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Hotels" asp-action="Index">
                            <i class="bi bi-house-door me-1"></i>Hôtels
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Appreciations" asp-action="Index">
                            <i class="bi bi-star me-1"></i>Appréciations
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container mt-4 mb-5">
        @RenderBody()
    </main>

    <footer>
        <div class="container text-center">
            <p class="mb-0">
                <i class="bi bi-building me-1"></i>
                &copy; @DateTime.Now.Year - Hotellerie App &mdash; ASP.NET Core MVC 8.0 &mdash; Hiba
            </p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
